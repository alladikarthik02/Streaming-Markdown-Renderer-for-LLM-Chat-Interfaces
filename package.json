{
  "name": "@alladikarthik/stream-md",
  "version": "0.1.0",
  "description": "Safe incremental Markdown rendering for React chat interfaces",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm build:demo",
    "verify:package": "pnpm build && node scripts/verify-package.mjs",
    "bench:generate": "node bench/generate.mjs",
    "bench:build": "vite build --config vite.bench.config.ts",
    "bench": "pnpm bench:build && playwright test --config playwright.bench.config.ts",
    "bench:smoke": "pnpm bench:build && BENCH_SMOKE=1 playwright test --config playwright.bench.config.ts",
    "bench:gate": "node bench/gate.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "streamdown": "2.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "entities": "8.1.0",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "marked": "18.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alladikarthik02/Streaming-Markdown-Renderer-for-LLM-Chat-Interfaces.git"
  },
  "homepage": "https://github.com/alladikarthik02/Streaming-Markdown-Renderer-for-LLM-Chat-Interfaces#readme"
}
